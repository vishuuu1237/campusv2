{
  "version": 2,
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "../backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
