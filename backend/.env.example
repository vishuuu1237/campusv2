# Server Port
PORT=2210

# JWT Secret
JWT_SECRET=your-secret-key-here-change-in-production

# ZapUPI / Payment Gateway Configuration
ZAP_UPI_API_KEY=your_zap_upi_api_key_here
ZAP_UPI_BASE_URL=https://pay.zapupi.com
ZAP_UPI_SERVER_GATEWAY_IP=
ZAP_UPI_SIMULATION=false

# Alternative / Generic Gateway Variable Names (Supported Fallback)
# PAYMENT_GATEWAY_KEY=your_gateway_key_here
# PAYMENT_GATEWAY_BASE_URL=https://pay.zapupi.com
# PAYMENT_GATEWAY_URL=https://pay.zapupi.com
